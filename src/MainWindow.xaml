<Window
    x:Class="FlClashUpdater.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootPanel" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="OnLoaded">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24" Padding="32" MaxWidth="800" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="FlClash 更新器" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Text="检查并安装最新版本" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="代理设置" ToolTipService.ToolTip="代理设置">
                        <FontIcon Glyph="&#xE713;" FontSize="18" />
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Width="300" Spacing="12">
                                    <TextBlock Text="HTTP 代理" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <TextBox x:Name="ProxyBox" PlaceholderText="留空使用系统代理" />
                                    <TextBlock Text="例如 http://127.0.0.1:7890" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Content="保存" Click="SaveProxy" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock Text="当前版本" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="CurrentVersion" Text="—" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock x:Name="ArchitectureText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="最新版本" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="LatestVersion" Text="—" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="GitHub 正式版" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Spacing="14">
                    <TextBlock x:Name="StatusText" Text="准备就绪" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ProgressBar x:Name="DownloadProgress" IsIndeterminate="False" />
                    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="False" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="RetryButton" Content="检查并更新" Style="{StaticResource AccentButtonStyle}" Click="Retry" />
                        <Button x:Name="CancelButton" Content="取消" Click="Cancel" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
                <Expander Header="详细信息" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="InstallPathText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="180" />
                    </StackPanel>
                </Expander>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <HyperlinkButton Content="发布页面" NavigateUri="https://github.com/chen08209/FlClash/releases" Padding="0" />
                    <HyperlinkButton Grid.Column="1" Content="打开日志" Click="OpenLogs" Padding="0" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
